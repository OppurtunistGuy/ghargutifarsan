# Website (public, baked into the build). The dedicated WhatsApp Business number, digits only with
# the country code, e.g. 91XXXXXXXXXX. Leave empty to keep the WhatsApp buttons disabled.
VITE_WHATSAPP_NUMBER=

# WhatsApp assistant (server secrets; set them in Vercel, never in VITE_ variables).
# See docs/whatsapp-assistant.md for what each one is.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_CUSTOMER_TEMPLATE=
